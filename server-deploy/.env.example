PORT=3000
NODE_ENV=production

# ============== 数据库（PostgreSQL 必填） ==============
DATABASE_URL=postgresql://health:CHANGE_ME@postgres:5432/health_platform?schema=public&connection_limit=20&pool_timeout=20
DB_PROVIDER=postgresql

# ============== Redis ==============
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# ============== MinIO 对象存储 ==============
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=health

# ============== JWT ==============
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_BYTES
JWT_EXPIRES_IN=7d

# ============== 默认账号（首次部署会被 deploy.sh 覆盖为强随机密码） ==============
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=ChangeMe@FirstLogin!
ALLOW_PUBLIC_REGISTRATION=false
DEFAULT_STORE_CODE=DEFAULT

# ============== 微信 ==============
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TOKEN=healthclinic
WECHAT_AES_KEY=
WECHAT_TEMPLATE_DETECTION=DETECTION_COMPLETED_TEMPLATE_ID
WECHAT_TEMPLATE_REMIND=REMIND_TEMPLATE_ID
WEB_BASE_URL=https://your-domain.com

# ============== 支付 ==============
WECHAT_PAY_ALLOW_MOCK=false
ALIPAY_ALLOW_MOCK=false

# ============== CORS ==============
CORS_ORIGINS=https://your-domain.com,https://admin.your-domain.com

# ============== 日志 ==============
LOG_LEVEL=info
