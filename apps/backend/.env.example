PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://health:health123@localhost:5432/health_platform?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=health
JWT_SECRET=please-change-this-secret-in-production
JWT_EXPIRES_IN=7d
WECHAT_APP_ID=wx0000000000000000
WECHAT_APP_SECRET=00000000000000000000000000000000
WECHAT_TOKEN=healthclinic
WECHAT_AES_KEY=
WECHAT_TEMPLATE_DETECTION=DETECTION_COMPLETED_TEMPLATE_ID
WECHAT_TEMPLATE_REMIND=REMIND_TEMPLATE_ID
ALLOW_PUBLIC_REGISTRATION=true
DEFAULT_STORE_CODE=DEFAULT
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
LOG_LEVEL=info

# ============================================
# AI 接口（总台在「系统设置 -> AI接口配置」中配置，门店无权限）
# 以下仅为兜底默认值，实际密钥建议在系统内配置
# ============================================
DEFAULT_AI_PROVIDER=minimax
# 可选供应商：qwen / doubao / kimi / minimax / deepseek / zhipu / ant-ling
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3
MINIMAX_API_KEY=
ANT_LING_BASE_URL=https://api.ant-ling.com/v1
ANT_LING_MODEL=Ling-max-2.0
ANT_LING_API_KEY=
